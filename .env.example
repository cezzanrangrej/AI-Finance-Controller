# Environment variables for AI Finance Controller

# LLM Provider selection: demo | gemini | openrouter
LLM_PROVIDER=demo

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct


# Database (defaults to sqlite:///./data/finance_controller.db if unset)
DATABASE_URL=


