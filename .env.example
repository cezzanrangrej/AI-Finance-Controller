# Environment variables for AI Finance Controller

# ---------------------------------------------------------------------------
# Offline demo mode
# ---------------------------------------------------------------------------
# Hard kill switch. When true, both agents run against the local rule-based
# emulator and no external API is contacted, regardless of any provider or key
# set below. Use this for key-less demos and deterministic tests.
DEMO_MODE=false

# ---------------------------------------------------------------------------
# Provider configuration
# ---------------------------------------------------------------------------
# The multi-agent pipeline resolves the Investigator and Verifier independently.
# You can configure them either way:
#
#   a) Set LLM_PROVIDER alone -- both roles use it.
#   b) Set INVESTIGATOR_PROVIDER / VERIFIER_PROVIDER alone -- each role uses its
#      own, and LLM_PROVIDER is not required.
#   c) Set both -- the role values win, LLM_PROVIDER covers any role left blank.
#
# If a role names a provider but its key or model is missing, that role alone
# falls back to the demo engine and a WARNING is logged; the run is recorded with
# llm_degraded=true so its decisions are never mistaken for real-model output.
#
# Valid: gemini | openrouter | agentrouter | demo
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Per-role overrides. Leave the provider blank to inherit LLM_PROVIDER.
# A blank model inherits the provider's shared model above; OpenRouter and
# AgentRouter have no default, so they need one set explicitly somewhere.
INVESTIGATOR_PROVIDER=openrouter
INVESTIGATOR_API_KEY=
INVESTIGATOR_MODEL=

VERIFIER_PROVIDER=gemini
VERIFIER_API_KEY=
VERIFIER_MODEL=

DATABASE_URL=

SHOW_AGENT_TRACE=false
AGENT_TRACE_LEVEL=verbose

MAX_PARALLEL_BATCHES=5
