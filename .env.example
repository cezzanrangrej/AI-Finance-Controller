# Environment variables for ReconPilot
# Valid: gemini | openrouter | demo
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Per-role overrides. Leave the provider blank to inherit LLM_PROVIDER.
# A blank model inherits the provider's shared model above; OpenRouter and
INVESTIGATOR_PROVIDER=openrouter
INVESTIGATOR_API_KEY=
#current free model which i'm using right now
INVESTIGATOR_MODEL=minimax/minimax-m3:free

VERIFIER_PROVIDER=gemini
VERIFIER_API_KEY=
VERIFIER_MODEL=gemini-3.6-flash

DATABASE_URL=

